{
  "name": "pcf-refs",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "postinstall": "papi",
    "pin": "node src/cli/pin.ts",
    "encode": "node src/cli/encode.ts",
    "decode": "node src/cli/decode.ts",
    "preflight": "node src/cli/preflight.ts",
    "dry-run": "node src/cli/dry-run.ts",
    "rehearse": "node src/cli/rehearse.ts",
    "verify": "node src/cli/verify.ts",
    "check": "npm run encode -- --check && npm run decode && npm run preflight && npm run dry-run",
    "papi:update": "papi update && papi",
    "lint": "biome check --error-on-warnings",
    "lint:fix": "biome check --write",
    "typecheck": "tsc",
    "test": "node --test test/*.test.ts",
    "bundle": "node src/cli/bundle.ts"
  },
  "devDependencies": {
    "@acala-network/chopsticks": "1.5.2",
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.1",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@polkadot-api/descriptors": "file:.papi/descriptors",
    "@polkadot-api/substrate-bindings": "0.21.2",
    "polkadot-api": "3.2.1",
    "viem": "2.57.3"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2"
  }
}
